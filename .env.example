# Copy to .env and fill in. Never commit real keys.
# Comma-separated Gemini keys. IDs become key_1, key_2, ... in this order.
# IMPORTANT: Gemini rate limits are per Google Cloud PROJECT, so create each key in a different project.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# LiteLLM model name. Verify it is available on your free tier in AI Studio.
LLM_MODEL=gemini/gemini-2.5-flash-lite
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Frontend (baked in at build time): public URL of the backend as seen by the BROWSER
VITE_API_BASE_URL=http://localhost:8000
